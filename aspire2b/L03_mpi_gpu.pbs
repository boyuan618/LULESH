#!/bin/bash
# L03: every OpenMPI we have on ASPIRE 2B, across two GPU-node slices with LULESH 2.0 (CPU only: the CUDA-linked builds just
# need the driver's libcuda, which exists only on GPU nodes). 8 ranks, 4 per node, -s 30 -i 100, OMP 1.
#  site openmpi/5.0.10-gcc15.3-cuda13.0 | our Open MPI 5.0.10 with cxi (deps/openmpi-5.0.10-cuda13.0-ofi) | our OpenMPI 4.1.6
#  (deps/openmpi-4.1.6-cuda13.0, no libfabric) | Cray MPICH (reference)
# each OpenMPI 5: mpirun default (libfabric), mpirun TCP only (ob1: self,sm,tcp), PALS mpiexec --pmi pmix. L01 (CPU nodes,
# site CPU module): PALS works (FOM 20878, Cray 20862/21802), mpirun default fails fi_domain -38.
# usage: /scratch/users/ntu/gubo0002/sc26/hpl_hplmxp/openmxp-scc26/aspire2b+stock/submit.sh aspire2b/L03_mpi_gpu.pbs
#PBS -N b2-L03
#PBS -q normal
#PBS -l select=2:ncpus=24:ngpus=1:mem=200gb
#PBS -l place=scatter
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /scratch/users/ntu/gubo0002/sc26/hpl_hplmxp/LULESH/aspire2b/L03_mpi_gpu.out
set -uo pipefail
L=/scratch/users/ntu/gubo0002/sc26/hpl_hplmxp/LULESH; OUT=$L/aspire2b/L03; mkdir -p $OUT
A=/scratch/users/ntu/gubo0002/sc26/hpl_hplmxp/openmxp-scc26/aspire2b+stock
echo "=== $(hostname) $(date) job $PBS_JOBID ==="
qstat -f $PBS_JOBID | grep -E 'exec_host|Resource_List.select|queue ='
H1=$(awk '{sub(/\..*/,"",$0)} !s[$0]++' $PBS_NODEFILE | head -1)
envmod() {  # envmod <site|own5|own4|cray>
  set +eu; source /etc/profile >/dev/null 2>&1; type module >/dev/null 2>&1 || source /opt/cray/pe/lmod/lmod/init/bash
  module use /data/apps/modulefiles
  case $1 in site) module unload cray-mpich; module load openmpi/5.0.10-gcc15.3-cuda13.0;;
    own5) source $A/env_ompi5.sh;; own4) source $A/env_ompi4.sh;; cray) module load PrgEnv-gnu cray-mpich;; esac
  set -u
}
build() {  # build <site|own5|own4|cray>
  local B=$OUT/build_$1; rm -rf $B; mkdir -p $B
  ( envmod $1; cd $B; local cxx=mpicxx; [ $1 = cray ] && cxx=CC
    echo "$1: $(command -v $cxx) | $(command -v mpirun 2>/dev/null) $(mpirun --version 2>/dev/null | head -1)"
    /usr/bin/cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=$cxx $L > cmake.log 2>&1 && make -j8 > make.log 2>&1 ) \
    && [ -x $B/lulesh2.0 ] && echo "  built" || { echo "  BUILD $1 FAILED"; tail -12 $B/cmake.log $B/make.log; }
}
for m in site own5 own4 cray; do build $m; done
run() {  # run <tag> <site|own5|own4|cray> <launcher...>
  local tag=$1 mpi=$2; shift 2; local log=$OUT/$tag.log
  echo "--- $tag: $* $(date +%T)"
  ( envmod $mpi; export OMP_NUM_THREADS=1; timeout 300 "$@" $OUT/build_$mpi/lulesh2.0 -s 30 -i 100 ) > $log 2>&1
  local rc=$?; echo "  rc=$rc $(grep -m1 'FOM' $log || echo 'no FOM')"
  grep -aE 'fi_domain|Function not implemented|select: component .* selected|not enough slots|GLIBCXX|Abort|Segmentation' $log | sed 's/^\[[^]]*\] //' | sort | uniq -c | sort -rn | head -4 | cut -c1-150
}
PX=/opt/cray/pals/1.7/bin/mpiexec
export OMPI_MCA_pml_base_verbose=10 OMPI_MCA_mtl_base_verbose=10 OMPI_MCA_btl_base_verbose=0
X5="-x LD_LIBRARY_PATH -x OMPI_MCA_pml_base_verbose -x OMPI_MCA_mtl_base_verbose"
TCP="--mca pml ob1 --mca btl self,sm,tcp --mca mtl ^ofi"
run cray_pals            cray $PX -n 8 --ppn 4 --cpu-bind depth -d 1
for m in site own5; do
  run ${m}_mpirun_default  $m mpirun -n 8 --map-by ppr:4:node --bind-to core --oversubscribe $X5
  run ${m}_mpirun_tcp      $m mpirun -n 8 --map-by ppr:4:node --bind-to core --oversubscribe $X5 $TCP
  run ${m}_pals            $m $PX --pmi pmix --no-transfer -n 8 --ppn 4 --cpu-bind depth -d 1
done
run own4_mpirun          own4 mpirun --prefix /scratch/users/ntu/gubo0002/sc26/hpl_hplmxp/deps/openmpi-4.1.6-cuda13.0 -n 8 --map-by ppr:4:node --bind-to core --oversubscribe -x LD_LIBRARY_PATH --mca btl self,vader,tcp
run cray_pals_r2         cray $PX -n 8 --ppn 4 --cpu-bind depth -d 1
echo "=== L03 DONE $(date) ==="
