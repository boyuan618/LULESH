#!/bin/bash
# L01: does OpenMPI work across ASPIRE 2B nodes at all? LULESH 2.0 (CPU, MPI + OpenMP) on two CPU nodes, 4 ranks each
# (8 = 2^3, LULESH needs a cube), -s 30 -i 100, OMP 1. No GPU, CUDA or container involved.
# Builds: the site CPU OpenMPI 5.0.10 (openmpi/5.0.10-gcc15.3-cpu: libfabric/CXI, PMIx) and Cray MPICH (PrgEnv-gnu, CC).
# Runs:  cray PALS (reference) | ompi mpirun default (OFI) on 2 nodes and on 1 | ompi mpirun with OFI off (ob1: tcp + sm)
#        | ompi PALS mpiexec --pmi pmix (default OFI)
# On the GPU nodes (openmxp-scc26 aspire2b+stock B03, B22-B23): mpirun-started OpenMPI fails at fi_domain with -38 (no
# Slingshot credentials; only PALS-started processes get them), PALS-started reaches Slingshot.
# usage: /scratch/users/ntu/gubo0002/sc26/hpl_hplmxp/openmxp-scc26/aspire2b+stock/submit.sh aspire2b/L01_mpi.pbs
#PBS -N b2-L01
#PBS -q normal
#PBS -l select=2:ncpus=8:mpiprocs=4:mem=24gb
#PBS -l place=scatter
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o /scratch/users/ntu/gubo0002/sc26/hpl_hplmxp/LULESH/aspire2b/L01_mpi.out
set -uo pipefail
L=/scratch/users/ntu/gubo0002/sc26/hpl_hplmxp/LULESH; OUT=$L/aspire2b/L01; mkdir -p $OUT
echo "=== $(hostname) $(date) job $PBS_JOBID ==="
qstat -f $PBS_JOBID | grep -E 'exec_host|Resource_List.select|queue ='
HOSTS=$(awk '{sub(/\..*/,"",$0)} !s[$0]++' $PBS_NODEFILE | paste -sd' '); echo "nodes: $HOSTS"; H1=${HOSTS%% *}
envmod() {  # envmod <cray|ompi>: a clean module environment for one MPI
  set +eu; source /etc/profile >/dev/null 2>&1; type module >/dev/null 2>&1 || source /opt/cray/pe/lmod/lmod/init/bash
  module use /data/apps/modulefiles
  if [ $1 = ompi ]; then module unload cray-mpich; module load openmpi/5.0.10-gcc15.3-cpu; else module load PrgEnv-gnu cray-mpich; fi
  set -u
}
build() {  # build <cray|ompi>
  local B=$OUT/build_$1; rm -rf $B; mkdir -p $B
  ( envmod $1; cd $B; local cxx=CC; [ $1 = ompi ] && cxx=mpicxx
    echo "$1: $(command -v $cxx) $($cxx --version | head -1)"; [ $1 = ompi ] && mpirun --version | head -1
    /usr/bin/cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=$cxx $L > cmake.log 2>&1 && make -j8 > make.log 2>&1 ) \
    && [ -x $B/lulesh2.0 ] && echo "built $B/lulesh2.0" || { echo "BUILD $1 FAILED"; tail -15 $B/cmake.log $B/make.log; }
}
build cray; build ompi
run() {  # run <tag> <cray|ompi> <launcher...>
  local tag=$1 mpi=$2; shift 2; local log=$OUT/$tag.log
  echo "--- $tag: $* $(date +%T)"
  ( envmod $mpi; export OMP_NUM_THREADS=1; timeout 300 "$@" $OUT/build_$mpi/lulesh2.0 -s 30 -i 100 ) > $log 2>&1
  local rc=$?; local fom=$(grep -E 'FOM' $log | head -1)
  echo "  rc=$rc ${fom:-no FOM} | $(grep -m1 -E 'Elapsed time' $log)"
  grep -aE 'fi_domain|Function not implemented|Selected component|select:.*selected|not enough slots|Abort|Segmentation|ERROR' $log | sed 's/^\[[^]]*\] //' | sort | uniq -c | sort -rn | head -5 | cut -c1-160
}
PX=/opt/cray/pals/1.7/bin/mpiexec
VB="-x OMPI_MCA_pml_base_verbose=10 -x OMPI_MCA_mtl_base_verbose=10"
export OMPI_MCA_pml_base_verbose=10 OMPI_MCA_mtl_base_verbose=10   # for the PALS-started OpenMPI (PALS passes the environment)
run cray_pals          cray $PX -n 8 --ppn 4 --cpu-bind depth -d 1
run ompi_mpirun_2node  ompi mpirun -n 8 --map-by ppr:4:node --bind-to core $VB
run ompi_mpirun_1node  ompi mpirun -n 8 --host $H1:8 --oversubscribe --bind-to core $VB
run ompi_mpirun_tcp    ompi mpirun -n 8 --map-by ppr:4:node --bind-to core --mca pml ob1 --mca btl self,sm,tcp --mca mtl ^ofi $VB
run ompi_pals          ompi $PX --pmi pmix --no-transfer -n 8 --ppn 4 --cpu-bind depth -d 1
run cray_pals_r2       cray $PX -n 8 --ppn 4 --cpu-bind depth -d 1
echo "=== L01 DONE $(date) ==="
